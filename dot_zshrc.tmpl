# Uncomment the following line to enable profiling (time taken by each command)
# You also need to uncomment the last line : zprof
# zmodload zsh/zprof

# ~/.zshrc
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"

# Default terminal
export EDITOR=nvim

# Enable VIM mode
bindkey -v

# Aliases
alias n='nvim'
alias cd='z'

# NVM (Homebrew) — lazy-loaded (calling nvm at startup cost ~650ms per shell).
# The default node's bin dir goes on PATH directly from nvm's alias files;
# nvm itself is sourced the first time `nvm` runs.
# Fresh machine: no versions installed → nothing added, brew node serves
# until `nvm install --default <ver>`.
export NVM_DIR="$HOME/.nvm" # https://github.com/nvm-sh/nvm/issues/539#issuecomment-245791291
[ -d "$NVM_DIR" ] || mkdir -p "$NVM_DIR"
() {
  local def=default bins i
  for i in {1..5}; do   # follow alias chain: default -> lts/* -> lts/<name> -> vX.Y.Z
    [[ -f $NVM_DIR/alias/$def ]] || break
    def=$(<$NVM_DIR/alias/$def)
  done
  bins=($NVM_DIR/versions/node/v${def#v}*/bin(N/nOn))         # exact or partial ("24")
  (( $#bins )) || bins=($NVM_DIR/versions/node/v*/bin(N/nOn)) # fallback: newest installed
  (( $#bins )) && path=($bins[1] $path)
}
nvm() {
  unfunction nvm
  . /opt/homebrew/opt/nvm/nvm.sh --no-use
  nvm "$@"
}

{{ if eq .profile "work" -}}
#GCloud
export PATH=/opt/homebrew/share/google-cloud-sdk/bin:"$PATH"

#Dart
export PATH="$PATH":"$HOME/.pub-cache/bin"

{{ end -}}
#Android dev tools
export PATH="$HOME/Library/Android/sdk/platform-tools:$PATH"

# Golang
export GOPATH="$HOME/go"
export PATH="$PATH:$GOPATH/bin"

# Docker CLI completions — must be on fpath before zsh-autocomplete, which
# runs compinit itself (don't call compinit here; Docker Desktop's appended
# `compinit` block ran it a second time on every shell).
[[ -d $HOME/.docker/completions ]] && fpath=($HOME/.docker/completions $fpath)

# ZSH Plugins
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source /opt/homebrew/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh

# FZF
source <(fzf --zsh)
export FZF_DEFAULT_OPTS="--preview 'bat --color=always {}'"

# syntax-highlighting must be sourced last
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

## Yazi
function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

