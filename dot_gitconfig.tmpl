[user]
{{- if eq .profile "work" }}
	email = frederick.beaulieu@canac.ca
{{- else }}
	email = frederick.beaulieu@hotmail.com
{{- end }}
	name = Frédérick Beaulieu
	signingKey =
[gpg]
	program = gpg
	format = openpgp
[commit]
	gpgSign = false
[tag]
	forceSignAnnotated = false
[gpg "ssh"]
	program =
	allowedSignersFile =
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

{{ if eq .profile "work" -}}
# Canac work identity: everything under ~/Git is work
[includeIf "gitdir:~/Git/"]
	path = ~/.config/git/canac
# Backup rule: canac remotes cloned anywhere else
[includeIf "hasconfig:remote.*.url:https://github.com/canac-org/**"]
	path = ~/.config/git/canac
[includeIf "hasconfig:remote.*.url:git@github.com:canac-org/**"]
	path = ~/.config/git/canac
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/canac-org/**"]
	path = ~/.config/git/canac
[includeIf "hasconfig:remote.*.url:https://*bitbucket.org/canac/**"]
	path = ~/.config/git/canac
[includeIf "hasconfig:remote.*.url:git@bitbucket.org:canac/**"]
	path = ~/.config/git/canac
[includeIf "hasconfig:remote.*.url:ssh://git@bitbucket.org/canac/**"]
	path = ~/.config/git/canac
{{ end -}}
# GitHub HTTPS auth via gh (token lives in the macOS keychain, not here).
# The empty helper clears inherited helpers (e.g. osxkeychain).
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
