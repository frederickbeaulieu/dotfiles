# stow ignore list for the `files` package.
# Patterns are Perl regexes matched against each path (relative to this dir)
# and its basename. A match prunes the file/dir from stow operations,
# including the --simulate runs used by `stow_override`.

# stow meta + OS cruft
\.stow-local-ignore
\.DS_Store

# nested VCS metadata (nvim is vendored; guard against stray repos)
\.git

# secrets — never symlink credentials into $HOME
auth0
firebase
configstore
graphite

# github-copilot machine state: chat sessions, embedded DBs, lock files.
# Editor/instruction configs under github-copilot/ are kept.
github-copilot/iu
.*\.db$
.*\.lck$
.*\.xd$

# tool state / cache / credentials — guard against future stray copies
gcloud
flutter
cagent
gh/hosts.yml
jj/repos
